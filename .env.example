# คัดลอกไฟล์นี้เป็น .env แล้วเติมค่าจริง  (cp .env.example .env)
# ไฟล์ .env จะไม่ถูก push ขึ้น git (อยู่ใน .gitignore)

# URL ของแอป cloud/server ที่รับคลิป (ถ้าเว้นว่าง = fallback ไป Google Drive)
CLOUD_API_URL=http://localhost:3000/clips

# device key ของเครื่องกล้องนี้ — ต้องตรงกับ DEVICE_KEY ฝั่ง server
CLOUD_API_KEY=ใส่-device-key-ที่นี่

# รหัสคอร์ทเริ่มต้น (ถ้า operator ไม่ส่ง court มา)
COURT_ID=A
